model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  
  ownedBoards  Board[]       @relation("BoardOwner")
  boardMembers BoardMember[]
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

    

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  position    Float
  columnId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  column Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
  @@map("tasks")
}